import streamlit as st

st.set_page_config(page_title="Grocery Bill Calculator")

st.title("🛒 Grocery Bill Calculator")

st.write("Enter grocery item details below:")

# Initialize total
total_bill = 0

# Number of items
num_items = st.number_input("How many items?", min_value=1, step=1)

# Store item details
items = []

for i in range(num_items):
    st.subheader(f"Item {i+1}")

    item_name = st.text_input(f"Enter item name {i+1}", key=f"name{i}")
    quantity = st.number_input(
        f"Enter quantity for {item_name if item_name else 'item'}",
        min_value=1,
        step=1,
        key=f"qty{i}"
    )

    price = st.number_input(
        f"Enter price per item for {item_name if item_name else 'item'}",
        min_value=0.0,
        step=1.0,
        key=f"price{i}"
    )

    item_total = quantity * price
    total_bill += item_total

    items.append((item_name, quantity, price, item_total))

# Show bill
if st.button("Generate Bill"):
    st.header("🧾 Final Bill")

    for item in items:
        st.write(
            f"**{item[0]}** → {item[1]} × ₹{item[2]} = ₹{item[3]}"
        )

    st.success(f"Total Grocery Bill = ₹{total_bill}")
